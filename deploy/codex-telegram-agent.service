[Unit]
Description=Private Codex worker for Telegram
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/maksym/projects/codex-telegram-agent
Environment=PYTHONPATH=/home/maksym/projects/codex-telegram-agent/src
ExecStart=/home/maksym/projects/codex-telegram-agent/.venv/bin/python -m codex_telegram_agent
Restart=on-failure
RestartSec=10
KillMode=control-group
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
LockPersonality=true
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
